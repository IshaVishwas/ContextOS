{
  "manifest_version": 3,
  "name": "ContextOS Extension",
  "version": "1.0.0",
  "description": "ContextOS integration for ChatGPT, Gemini, and Claude.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://gemini.google.com/*",
        "*://claude.ai/*"
      ],
      "js": [
        "scripts/storage.js",
        "scripts/communication.js",
        "scripts/providers/base.js",
        "scripts/providers/chatgpt.js",
        "scripts/providers/gemini.js",
        "scripts/providers/claude.js",
        "scripts/observer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
